# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated field binaries (32MB+ each, regenerate via: node scripts/generate-fields.js)
public/targets/2048/*.bin

# reference material
/docs+examples/
codepen_examples1.txt

# review captures, reference frames and working notes stay local
/docs/review/

# screenshots
Screenshot *.png

.agent

.agents

.claude

.codex

.hermes

# local runs / captures
/.playwright-cli/
/.playwright-mcp/
/output/
*.mov

# local recovery and duplicate agent installs
/.recovery/
/agent/

# Python / Blender local state
**/__pycache__/
*.py[cod]
*.blend1

# reproducible review artifacts kept out of repository history
/artifacts/clip-a-review/
/artifacts/design-audit/
/artifacts/scrub-test/
/artifacts/lenox-blender/lenox-blockout-v001.png
/artifacts/lenox-blender/v002/
/artifacts/lenox-blender/v003/
/docs/lenox-examples/

# superseded generated LENOX intermediates
/assets/lenox/lenox-blockout-v001.blend
/assets/lenox/lenox-v002.blend
/assets/lenox/lenox-v003.blend
/public/models/lenox/lenox-v002.glb
/public/models/lenox/lenox-v003.glb

